# Base URL of the deployed web app whose /api/start and /api/tick the VAR Room calls.
SANITY_APP_WEB_URL=
# Shared secret that lets the VAR Room pick a specific incident via /api/start. Must match the web app's
# VARDICT_OPERATOR_KEY. App SDK env vars prefixed SANITY_APP_ are bundled into the app served to org members.
SANITY_APP_OPERATOR_KEY=
