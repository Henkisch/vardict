# Public: the same values as the root .env.example (t2sbu6uu / production). Safe in browser code.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=

# Server-only: the workflow engine's private dataset. Defaults to "workflows" if unset.
SANITY_WORKFLOWS_DATASET=

# Server-only, never sent to the browser: creates referendums and votes, drives the workflow engine.
SANITY_WRITE_TOKEN=

# Shared secret that lets the VAR Room pick a specific incident via /api/start instead of "next in line".
# Must match var-room's SANITY_APP_OPERATOR_KEY. Leave unset locally if you're not testing that path.
VARDICT_OPERATOR_KEY=

# Kill switch: set to 1 to make /api/start, /api/vote and /api/crowd answer 503 without a deploy.
VARDICT_PAUSED=

# Set by Vercel itself in every deployment; only PORT matters locally, and Next already defaults it to 3000.
# PORT=
# VERCEL_ENV=
# VERCEL_PROJECT_PRODUCTION_URL=
